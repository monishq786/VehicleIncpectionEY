                                                <ObjectAttribute press="onPressShortClose" class="cl_objAttriwhite sapUiTinyMarginTop" title="" text="Short Close" active="true" />
                                                <Image press="onPressShortClose" class="sapUiTinyMarginBegin sapUiTinyMarginTop" src="{imageModel>/path}/image/Shortclose.png" width="20px" height="20px" />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </f:GridListItem>
                        </f:GridList>
                    </Carousel>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
