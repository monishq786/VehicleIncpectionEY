                                            <Text text="IN" class="sapUiSmallMarginTop"/>
                                            <Image src="{imageModel>/path}/image/GreenDot.png" width="36px" height="36px" visible="{= ${VIRGlobalModel>MahaIn} === 'X'? true : false}" />
                                            <Image src="{imageModel>/path}/image/RedDot.png" width="36px" height="36px" visible="{= ${VIRGlobalModel>MahaIn} === ''? true : false}" />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginBegin" alignContent="Center" alignItems="Center" visible="{= ${VIRGlobalModel>MahaHide} === 'X'? false : true}">
                                            <Text text="Out" class="sapUiSmallMarginTop"/>
