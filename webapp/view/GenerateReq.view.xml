                                            <Image src="{imageModel>/path}/image/RedDot.png" width="36px" height="36px" visible="{= ${VIRGlobalModel>MahaOut} === ''? true : false}" />
                                        </VBox>
                                        <VBox class="sapUiTinyMarginBottom sapUiMediumMarginBegin" alignContent="Center" alignItems="Center">
                                            <Text text="Visual" class="sapUiSmallMarginTop"/>
                                            <Image src="{imageModel>/path}/image/GreenDot.png" width="36px" height="36px" visible="{= ${VIRGlobalModel>Visual} === 'X'? true : false}" />
                                            <Image src="{imageModel>/path}/image/RedDot.png" width="36px" height="36px" visible="{= ${VIRGlobalModel>Visual} === ''? true : false}" />
                                        </VBox>
                                        <ToolbarSpacer />
                                        <VBox>
                                            <Button type="Transparent" icon="{imageModel>/path}/image/down.png" press="onpressVisualTest" />
                                        </VBox>
                                    </Toolbar>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>
                </content>
                <footer>
                    <OverflowToolbar enabled="true" visible="true">
                        <!-- <Button text="New Permit" class="cl_Emphasizebtn" type="Emphasized" press="onpressPermit" visible="{= ${VIRGlobalModel>/Purpose} === 'Permit'? true : false}" /> -->
                        <ToolbarSpacer />
                        <!-- <Button enabled="{SearchViewModel>/Btnenable}" text="Visual Test" press="onpressVisualTest" visible="{SearchViewModel>/PrintbtnVisible}" icon="{imageModel>/path}/image/view.png" type="Transparent" iconFirst="true" /> -->

                        <Button class="sapUiSmallMarginEnd" text="Proceed" type="Transparent" press="onPressSave" enabled="{SearchViewModel>/FieldsEditable}">
                            <customData>
                                <BadgeCustomData key="badge" value="{VIRGlobalModel>/MyCartCount}" visible="true" />
                            </customData>
                        </Button>
                        <Button text="Exit" type="Transparent" iconFirst="true" width="auto" visible="true" iconDensityAware="false" press="onExit" class="sapUiSmallMarginEnd cl_Emphasizebtn" />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </App>
</mvc:View>
