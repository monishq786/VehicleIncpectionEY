                    <List headerText="Service Tests" items="{VIRGlobalModel>/ServiceItems}" itemPress="onpressVisualTest" visible="{VIRGlobalModel>/CartItemVisble}" class="sapUiTinyMarginBeginEnd cl_custlisthdr">
                        <CustomListItem type="Active" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom cl_customlistcontent">
                            <HBox width="100%">
                                <VBox width="80%">
                                    <Text text="{VIRGlobalModel>Item} - {VIRGlobalModel>ServiceName}" class="sapUiTinyMarginTop" />
                                    <Text text="{VIRGlobalModel>/PlateNo} / {VIRGlobalModel>/PlateCode}" class="sapUiTinyMarginTopBottom" />
                                </VBox>
                                <VBox width="20%">
