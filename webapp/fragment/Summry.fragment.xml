<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:ui="sap.ui.table">
    <ResponsivePopover title="" showHeader="false" class="sapUiPopupWithPadding" placement="Right" contentHeight="auto" contentWidth="auto">
        <content>
            <Toolbar class="cl_toolbar1">
                <ToolbarSpacer />
                <Text text="Completed" />
                <Image src="{imageModel>/path}/image/MahaS.png" width="20px" height="20px" class="sapUiTinyMarginBegin" />
                <Text text="Not Completed" class="sapUiTinyMarginBegin"/>
                <Image src="{imageModel>/path}/image/MahaE.png" width="20px" height="20px" class="sapUiTinyMarginBegin" />
                <Text text="Not Applicable" class="sapUiTinyMarginBegin"/>
                <Image src="{imageModel>/path}/image/MahaA.png" width="20px" height="20px" class="sapUiTinyMarginBegin" />
            </Toolbar>
            <ui:Table width="28rem" class="sapUiSmallMarginBottom cl_uitable" rows="{SearchViewModel>/Status}" selectionMode="None" visibleRowCount="4">
                <ui:columns>
                    <ui:Column width="3rem">
                        <Label text="Item" />
                        <ui:template>
                            <Text text="{SearchViewModel>Item}" />
                        </ui:template>
                    </ui:Column>
                    <ui:Column width="8rem">
                        <Label text="Service" />
                        <ui:template>
                            <Text text="{SearchViewModel>Service}" />
                        </ui:template>
                    </ui:Column>
                    <ui:Column width="5rem">
                        <Label text="Visual" />
                        <ui:template>
                            <VBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === ''? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaS.png" width="22px" height="22px" visible="{= ${SearchViewModel>Visual} === 'X'? true : false}" />
                                    <Image src="{imageModel>/path}/image/MahaE.png" width="22px" height="22px" visible="{= ${SearchViewModel>Visual} === ''? true : false}" />
                                </HBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === 'X'? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaA.png" width="22px" height="22px" />
                                </HBox>
                            </VBox>
                        </ui:template>
                    </ui:Column>
                    <ui:Column width="5rem">
                        <Label text="MAHA In" />
                        <ui:template>
                            <VBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === ''? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaS.png" width="22px" height="22px" visible="{= ${SearchViewModel>MahaIn} === 'X'? true : false}" />
                                    <Image src="{imageModel>/path}/image/MahaE.png" width="22px" height="22px" visible="{= ${SearchViewModel>MahaIn} === ''? true : false}" />
                                </HBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === 'X'? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaA.png" width="22px" height="22px" />
                                </HBox>
                            </VBox>
                        </ui:template>
                    </ui:Column>
                    <ui:Column width="7rem">
                        <Label text="MAHA Out" />
                        <ui:template>
                            <VBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === ''? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaS.png" width="22px" height="22px" visible="{= ${SearchViewModel>MahaOut} === 'X'? true : false}" />
                                    <Image src="{imageModel>/path}/image/MahaE.png" width="22px" height="22px" visible="{= ${SearchViewModel>MahaOut} === ''? true : false}" />
                                </HBox>
                                <HBox visible="{= ${SearchViewModel>NotApplicable} === 'X'? true : false}">
                                    <Image src="{imageModel>/path}/image/MahaA.png" width="22px" height="22px" />
                                </HBox>
                            </VBox>
                        </ui:template>
                    </ui:Column>
                </ui:columns>
            </ui:Table>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>