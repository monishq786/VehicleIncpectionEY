			<f:Form editable="true" class="cl_formlabel sapUiSmallMarginTop">
				<f:layout>
					<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0"
						emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2" singleContainerFullSize="false"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Chassis No">
								<f:fields>
									<Input value="{SearchViewModel>/NewChassisno}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Engine No">
								<f:fields>
									<Input value="{SearchViewModel>/NewEngineno}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Country">
								<f:fields>
									<Input value="{SearchViewModel>/NewCountry}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true" valueHelpOnly="true"
										valueHelpRequest="openCountryF4"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Manufacturer">
								<f:fields>
									<Input value="{SearchViewModel>/NewManufacturer}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true"
										valueHelpOnly="true" valueHelpRequest="openManufacturerF4"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Model">
								<f:fields>
									<Input value="{SearchViewModel>/NewModel}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true" valueHelpOnly="true"
										valueHelpRequest="openModelF4"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Plate Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/PlatetypeF4}" value="{SearchViewModel>/PlateType}">-->
									<!--	<core:ListItem key="{SearchViewModel>Category}" text="{SearchViewModel>Category}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewPlateType}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Kind">
								<f:fields>
									<ComboBox items="{CreateCustomerModel>/KindF4}" value="{SearchViewModel>/NewKind}" editable="{SearchViewModel>/PermitVehKindEditable}">
										<core:ListItem key="{CreateCustomerModel>Kind}" text="{CreateCustomerModel>Kind}"/>
									</ComboBox>
									<!--<Input value="{SearchViewModel>/NewKind}" editable="{SearchViewModel>/PermitVehKindEditable}"/>-->
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/TypeF4}" value="{SearchViewModel>/Type}">-->
									<!--	<core:ListItem key="{SearchViewModel>Type}" text="{SearchViewModel>Type}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewType}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Body Color">
								<f:fields>
									<Input value="{SearchViewModel>/NewBodyColor}" editable="{SearchViewModel>/PermitColorEditable}" showValueHelp="true" valueHelpOnly="true"
										valueHelpRequest="openColorF4"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Gear Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/GearTypeF4}" value="{SearchViewModel>/GearType}">-->
									<!--	<core:ListItem key="{SearchViewModel>Gear}" text="{SearchViewModel>Gear}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewGearType}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Fuel Type">
								<f:fields>
									<ComboBox editable="{SearchViewModel>/PermitFuelTypeEditable}" items="{CreateCustomerModel>/FueltypeF4}"
										value="{SearchViewModel>/NewFuelType}">
										<core:ListItem key="{CreateCustomerModel>Type}" text="{CreateCustomerModel>Type}"/>
									</ComboBox>
									<!--<Input value="{SearchViewModel>/NewFuelType}" editable="{SearchViewModel>/PermitFuelTypeEditable}"/>-->
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Steering Side">
								<f:fields>
									<Input value="{SearchViewModel>/NewSteeringSide}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Weight Kind">
								<f:fields>
									<Input value="{SearchViewModel>/NewWeightKind}" editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Init Reg Year / Reg Exp Date">
								<f:fields>
									<DatePicker value="{SearchViewModel>/NewInitRegyear}" valueFormat="dd/mm/yyyy" editable="{SearchViewModel>/NewSearchFieldEditable}"></DatePicker>
									<DatePicker value="{SearchViewModel>/NewRegExpYear}" valueFormat="dd/mm/yyyy" editable="{SearchViewModel>/NewSearchFieldEditable}"></DatePicker>
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="MFG Year">
								<f:fields>
									<DatePicker width="50%" value="{SearchViewModel>/NewMFGYear}" displayFormat="yyyy" valueFormat="yyyy"
										editable="{SearchViewModel>/NewSearchFieldEditable}"/>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Horse Power">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewHP}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Axles">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewAxles}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Cylinders">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewCylinders}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Wheels">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewWheels}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Doors">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewDoors}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Passengers">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewPassengers}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Empty Weight">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewEmptyWeight}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Full Weight">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewFullWeight}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Mielage">
								<f:fields>
									<Input width="50%" value="{SearchViewModel>/Newmileage}"></Input>
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Cubic Capacity">
								<f:fields>
									<StepInput width="50%" value="{SearchViewModel>/NewCubicCapacity}" editable="{SearchViewModel>/NewSearchFieldEditable}"></StepInput>
								</f:fields>
							</f:FormElement>
							<!--<f:FormElement label="Customer Mobile No">-->
							<!--	<f:fields>-->
							<!--		<Input width="50%" placeholder="Mobile No" value="{SearchViewModel>/MObileNo}" maxLength="9"></Input>-->
							<!--	</f:fields>-->
							<!--</f:FormElement>-->
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer></f:FormContainer>
				</f:formContainers>
			</f:Form>
			<l:VerticalLayout width="100%" class="sapUiTinyMarginTop">
				<l:BlockLayout background="Dashboard">
					<l:BlockLayoutRow>
						<l:BlockLayoutCell width="3" class="Cl_VIBannerwidth">
							<Panel class="sapUiTinyMarginTop cl_panel" expanded="true" expandable="true" expand="onExpandCash" width="auto" expandAnimation="true">
								<headerToolbar>
									<OverflowToolbar height="3rem">
										<Title text="Representative Card Info"/>
										<ToolbarSpacer></ToolbarSpacer>
										<Button icon="sap-icon://add" press="onpressaddIdInfo"></Button>
										<Button icon="sap-icon://delete" press="onpressdeleteiditems"></Button>
									</OverflowToolbar>
								</headerToolbar>
								<content>
									<ui:Table width="auto" class="sapUiSmallMarginBottom cl_uitable" rows="{SearchViewModel>/IdInfoItems}" selectionMode="None"
										visibleRowCount="2">
										<ui:columns>
											<ui:Column width="9rem">
												<Label text="Type"/>
												<ui:template>
													<ComboBox items="{SearchViewModel>/IDTypes}" value="{SearchViewModel>Idtype}">
														<core:ListItem key="{SearchViewModel>Type}" text="{SearchViewModel>Type}"/>
													</ComboBox>
												</ui:template>
											</ui:Column>
											<ui:Column width="9rem">
												<Label text="ID#"/>
												<ui:template>
													<Input value="{SearchViewModel>Idno}"></Input>
												</ui:template>
											</ui:Column>
											<ui:Column width="9rem">
												<Label text="Date"/>
												<ui:template>
													<DatePicker value="{SearchViewModel>Iddate}"></DatePicker>
												</ui:template>
											</ui:Column>
											<ui:Column width="10rem">
												<Label text="Name"/>
												<ui:template>
													<HBox>
														<Input value="{SearchViewModel>Idname}"></Input>
													</HBox>
												</ui:template>
											</ui:Column>
										</ui:columns>
									</ui:Table>
								</content>
							</Panel>
						</l:BlockLayoutCell>
						<l:BlockLayoutCell width="3" class="Cl_VIBannerwidth">
							<Panel class="sapUiTinyMarginTop cl_panel" expanded="true" expandable="true" expand="onExpandCash" width="auto" expandAnimation="true">
								<headerToolbar>
									<OverflowToolbar height="3rem">
										<Title text="Certificate Details"/>
										<ToolbarSpacer></ToolbarSpacer>
										<Button icon="sap-icon://add" press="onpressaddcertitems"></Button>
											<Button icon="sap-icon://delete" press="onpressdeletecertitems"></Button>
									</OverflowToolbar>
								</headerToolbar>
								<content>
									<ui:Table width="auto" class="sapUiSmallMarginBottom cl_uitable" rows="{SearchViewModel>/CertificateItems}" selectionMode="None"
										visibleRowCount="2">
										<ui:columns>
											<ui:Column width="9rem">
												<Label text="Type"/>
												<ui:template>
													<ComboBox items="{SearchViewModel>/CertType}" value="{SearchViewModel>certtype}">
														<core:ListItem key="{SearchViewModel>Type}" text="{SearchViewModel>Type}"/>
													</ComboBox>
												</ui:template>
											</ui:Column>
											<ui:Column width="9rem">
												<Label text="ID#"/>
												<ui:template>
													<Input value="{SearchViewModel>certno}"></Input>
												</ui:template>
											</ui:Column>
											<ui:Column width="10rem">
												<Label text="Date"/>
												<ui:template>
													<DatePicker value="{SearchViewModel>certdate}"></DatePicker>
												</ui:template>
											</ui:Column>
										</ui:columns>
									</ui:Table>
								</content>
							</Panel>
						</l:BlockLayoutCell>
					</l:BlockLayoutRow>
				</l:BlockLayout>
			</l:VerticalLayout>
			<List id="id_VIUploadCollection" items="{AttachmentModel>/File}" mode="Delete" delete="deleteUploadedFile" enableBusyIndicator="true"
				headerText="" noDataText="No Data" growing="true" visible="true" class="sapUiTinyMarginTop">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="Attachments" class="cl_Ecertext"/>
						<ToolbarSpacer/>
						<u:FileUploader buttonText="Upload" buttonOnly="true" name="myFileUpload" value="" style="Emphasized" placeholder="{i18n>uploadPlaceholder}"
							change="onFileUploaderChange" enabled="true" id="fileUploader" class="cl_Emphasizebtn"/>
					</OverflowToolbar>
				</headerToolbar>
