			<f:Form editable="true" class="cl_formlabel sapUiSmallMarginTop">
				<f:layout>
					<f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="2" singleContainerFullSize="false"/>
				</f:layout>
				<f:formContainers>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="Chassis No">
								<f:fields>
									<Input value="{SearchViewModel>/NewChassisno}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="Chassis no" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Engine No">
								<f:fields>
									<Input value="{SearchViewModel>/NewEngineno}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="Engineno" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Country">
								<f:fields>
									<Input value="{SearchViewModel>/NewCountry}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="openCountryF4" />
									<Input type="Text" placeholder="Country" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Manufacturer">
								<f:fields>
									<Input value="{SearchViewModel>/NewManufacturer}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="openManufacturerF4" />
									<Input type="Text" placeholder="Manufacturer" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Model">
								<f:fields>
									<Input value="{SearchViewModel>/NewModel}" editable="{SearchViewModel>/NewSearchFieldEditable}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="openModelF4" />
									<Input type="Text" placeholder="Model" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Plate Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/PlatetypeF4}" value="{SearchViewModel>/PlateType}">-->
									<!--	<core:ListItem key="{SearchViewModel>Category}" text="{SearchViewModel>Category}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewPlateType}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="Plate Type" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Kind">
								<f:fields>
									<ComboBox items="{CreateCustomerModel>/KindF4}" value="{SearchViewModel>/NewKind}" editable="{SearchViewModel>/PermitVehKindEditable}">
										<core:ListItem key="{CreateCustomerModel>Kind}" text="{CreateCustomerModel>Kind}" />
									</ComboBox>
									<ComboBox items="{CreateCustomerModel>/KindF4}" value="{SearchViewModel>/NewKind}" editable="true">
										<core:ListItem key="{CreateCustomerModel>Kind}" text="{CreateCustomerModel>Kind}" />
									</ComboBox>
									<!--<Input value="{SearchViewModel>/NewKind}" editable="{SearchViewModel>/PermitVehKindEditable}"/>-->
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/TypeF4}" value="{SearchViewModel>/Type}">-->
									<!--	<core:ListItem key="{SearchViewModel>Type}" text="{SearchViewModel>Type}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewType}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="Type" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Body Color">
								<f:fields>
									<Input value="{SearchViewModel>/NewBodyColor}" editable="{SearchViewModel>/PermitColorEditable}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="openColorF4" />
									<Input type="Text" placeholder="Body Color" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Gear Type">
								<f:fields>
									<!--<ComboBox items="{SearchViewModel>/GearTypeF4}" value="{SearchViewModel>/GearType}">-->
									<!--	<core:ListItem key="{SearchViewModel>Gear}" text="{SearchViewModel>Gear}"/>-->
									<!--</ComboBox>-->
									<Input value="{SearchViewModel>/NewGearType}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="Gear Type" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Fuel Type">
								<f:fields>
									<ComboBox editable="{SearchViewModel>/PermitFuelTypeEditable}" items="{CreateCustomerModel>/FueltypeF4}" value="{SearchViewModel>/NewFuelType}">
										<core:ListItem key="{CreateCustomerModel>Type}" text="{CreateCustomerModel>Type}" />
									</ComboBox>
									<ComboBox editable="true" items="{CreateCustomerModel>/FueltypeF4}" value="{SearchViewModel>/NewFuelType}">
										<core:ListItem key="{CreateCustomerModel>Type}" text="{CreateCustomerModel>Type}" />
									</ComboBox>
									<!--<Input value="{SearchViewModel>/NewFuelType}" editable="{SearchViewModel>/PermitFuelTypeEditable}"/>-->
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Steering Side">
								<f:fields>
									<Input value="{SearchViewModel>/NewSteeringSide}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="SteeringSide" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Weight Kind">
								<f:fields>
									<Input value="{SearchViewModel>/NewWeightKind}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<Input type="Text" placeholder="WeightKind" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Init Reg Year / Reg Exp Date">
								<f:fields>
									<DatePicker value="{SearchViewModel>/NewInitRegyear}" valueFormat="dd/mm/yyyy" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<!-- <DatePicker value="{SearchViewModel>/NewRegExpYear}" valueFormat="dd/mm/yyyy" editable="{SearchViewModel>/NewSearchFieldEditable}"></DatePicker> -->

									<DatePicker value="{SearchViewModel>/NewRegExpYear}" valueFormat="dd/mm/yyyy" editable="true" />
								</f:fields>
							</f:FormElement>
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer>
						<f:formElements>
							<f:FormElement label="MFG Year">
								<f:fields>
									<DatePicker width="70%" value="{SearchViewModel>/NewMFGYear}" displayFormat="yyyy" valueFormat="yyyy" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<DatePicker value="" width="70%" displayFormat="yyyy" valueFormat="yyyy" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Horse Power">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewHP}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Axles">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewAxles}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Cylinders">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewCylinders}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Wheels">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewWheels}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Doors">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewDoors}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="No.of.Passengers">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewPassengers}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Empty Weight">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewEmptyWeight}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Full Weight">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewFullWeight}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Mielage">
								<f:fields>
									<Input width="70%" value="{SearchViewModel>/Newmileage}" />
									<Input width="70%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<f:FormElement label="Cubic Capacity">
								<f:fields>
									<StepInput width="70%" value="{SearchViewModel>/NewCubicCapacity}" editable="{SearchViewModel>/NewSearchFieldEditable}" />
									<StepInput width="30%" value="" editable="true" />
								</f:fields>
							</f:FormElement>
							<!--<f:FormElement label="Customer Mobile No">-->
							<!--	<f:fields>-->
							<!--		<Input width="50%" placeholder="Mobile No" value="{SearchViewModel>/MObileNo}" maxLength="9"></Input>-->
							<!--	</f:fields>-->
							<!--</f:FormElement>-->
						</f:formElements>
					</f:FormContainer>
					<f:FormContainer />
				</f:formContainers>
			</f:Form>
			<List id="id_VIUploadCollection" items="{AttachmentModel>/File}" mode="Delete" delete="deleteUploadedFile" enableBusyIndicator="true" headerText="" noDataText="No Data" growing="true" visible="true" class="sapUiTinyMarginTop">
				<headerToolbar>
					<OverflowToolbar>
						<Title text="Attachments"/>
						<ToolbarSpacer/>
						<u:FileUploader buttonText="Upload" buttonOnly="true" name="myFileUpload" value="" style="Emphasized" placeholder="{i18n>uploadPlaceholder}" change="onFileUploaderChange" enabled="true" id="fileUploader"/>
					</OverflowToolbar>
				</headerToolbar>
				<StandardListItem title="{AttachmentModel>Filename}" type="Active" press="fnpdf" iconDensityAware="false" iconInset="false" icon="{path:'AttachmentModel>FileType',formatter:'.formatter.onIconDisplay'}"/>
			</List>
			<Toolbar class="sapUiTinyMargin sapUiTinyMarginTop cl_CTtoolbar2" visible="{SearchViewModel>/PermitBtnVisible}">
				<Label class="cl_HeadingTooltext2" text="Comments" required="true"></Label>
			</Toolbar>
			<VBox class="sapUiTinyMargin" visible="{SearchViewModel>/PermitBtnVisible}">
				<TextArea width="100%" rows="5" required="true"></TextArea>
			</VBox>
			<!--		</IconTabFilter>-->
			<!--	</items>-->
			<!--</IconTabBar>-->
		</content>
		<buttons>
			<Button press="onpresssaveconf"  text="Save" type="Emphasized" iconFirst="true" width="auto" iconDensityAware="false" class="sapUiTinyMarginEnd" />

			<Button press="onpresssaveconf"  text="Confirm" type="Emphasized" iconFirst="true" width="auto" iconDensityAware="false" class="sapUiTinyMarginEnd" />

			<Button press="onCloseChangeinfof4"  text="Cancel" type="Emphasized" iconFirst="true" width="auto" iconDensityAware="false" class="sapUiTinyMarginEnd" />
